{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // GTB is both a library and the generator that scaffolds downstream tools.
  // The base policy (automerge posture, OSV alerts, first-party cicd-pin
  // automerge, gomod grouping, library range strategy) comes from the shared
  // phpboyscout/cicd presets below.
  extends: [
    'gitlab>phpboyscout/cicd:go',
    'gitlab>phpboyscout/cicd:library',
  ],
  // The pre-commit manager is OFF by default in Renovate, so without this the
  // hook `rev:` pins in this repo's own .pre-commit-config.yaml AND in the
  // generator's skeleton template (cli/pkg/generator/assets/skeleton/
  // .pre-commit-config.yaml) never move. Enabling it keeps both current so a
  // freshly generated project is never born with stale golangci-lint /
  // pre-commit-hooks pins.
  'pre-commit': {
    enabled: true,
  },
  // The generator bakes version pins into places no built-in manager reads —
  // Go source constants and Go-templated CI files under cli/pkg/generator/.
  // Without these customManagers those pins freeze (the cicd pin sat at
  // v0.10.5 while the framework itself ran v0.33.0), so every scaffold is born
  // stale until its own Renovate first runs. These trackers keep the template
  // pins current the same way the fleet keeps live projects current.
  //
  // The base preset's .gitlab-ci.yml trackers (cicd components, phpboyscout
  // images) apply here too: Renovate concatenates customManagers arrays.
  customManagers: [
    {
      customType: 'regex',
      description: 'Track the colophon release the project generator bakes into every scaffolded GitHub release workflow (ColophonVersion constant).',
      managerFilePatterns: [
        '/^cli/pkg/generator/generator\\.go$/',
      ],
      matchStrings: [
        'ColophonVersion\\s*=\\s*"(?<currentValue>v[\\d.]+)"',
      ],
      datasourceTemplate: 'go',
      depNameTemplate: 'gitlab.com/phpboyscout/colophon',
    },
    {
      customType: 'regex',
      description: 'Track the sigillum release the project generator bakes into every scaffolded GitHub release workflow that signs.',
      managerFilePatterns: [
        '/^cli/pkg/generator/generator\\.go$/',
      ],
      matchStrings: [
        'SigillumVersion\\s*=\\s*"(?<currentValue>v[\\d.]+)"',
      ],
      datasourceTemplate: 'go',
      depNameTemplate: 'gitlab.com/phpboyscout/sigillum',
    },
    {
      customType: 'regex',
      description: 'Track the phpboyscout/cicd component version the project generator bakes into every scaffolded .gitlab-ci.yml (CICDComponentVersion constant).',
      managerFilePatterns: [
        '/^cli/pkg/generator/generator\\.go$/',
      ],
      matchStrings: [
        'CICDComponentVersion\\s*=\\s*"(?<currentValue>v[\\d.]+)"',
      ],
      datasourceTemplate: 'gitlab-tags',
      depNameTemplate: 'phpboyscout/cicd',
      registryUrlTemplate: 'https://gitlab.com',
      extractVersionTemplate: '^(?<version>v[\\d.]+)$',
    },
    {
      customType: 'regex',
      description: 'Track the Python version pinned in the generator GitHub-workflow skeleton (setup-python input; a plain value the github-actions manager does not follow, unlike the uses: pins it already bumps).',
      managerFilePatterns: [
        '/^cli/pkg/generator/assets/skeleton-github/\\.github/workflows/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'python-version:\\s*["\']?(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'python',
    },
  ],
  // This is a Go workspace, and Renovate tidies cli/ on its own, so a bump
  // the root module and cli/ share left cli/ on the old pins and
  // go-work-sync failed (!726, !730, !731, !732). These are the job's own
  // pair; go mod tidy ignores go.work, so no GOWORK=off is needed. The bot
  // allows exactly these two commands (phpboyscout-private/renovate).
  packageRules: [
    {
      matchManagers: ['gomod'],
      postUpgradeTasks: {
        commands: ['go work sync', 'go -C cli mod tidy'],
        fileFilters: ['go.mod', 'go.sum', 'go.work', 'go.work.sum', 'cli/go.mod', 'cli/go.sum'],
        executionMode: 'branch',
        installTools: { golang: {} },
      },
    },
  ],
}
