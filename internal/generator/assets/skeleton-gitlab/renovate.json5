{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Extends the public phpboyscout/cicd preset, which carries the custom
  // manager that recognises and auto-bumps the
  // `gitlab.com/phpboyscout/cicd/*@vX.Y.Z` component pins in .gitlab-ci.yml.
  // Without this extend the component pins would never be bumped.
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':disableDependencyDashboard',
    'gitlab>phpboyscout/cicd',
  ],
  enabledManagers: [
    'gomod',
    'gitlabci',
    'pre-commit',
  ],
  rangeStrategy: 'bump',
  automerge: false,
  prHourlyLimit: 10,
  prConcurrentLimit: 10,
  branchConcurrentLimit: 20,
  'pre-commit': {
    enabled: true,
  },
  labels: [
    'renovate:{{ "{{" }}depName{{ "}}" }}',
    'renovate:{{ "{{" }}depName{{ "}}" }}/{{ "{{" }}newVersion{{ "}}" }}',
    'datasource:{{ "{{" }}datasource{{ "}}" }}',
  ],
  ignorePaths: [
    '**/vendor/**',
    '**/assets/**',
  ],
  gomod: {
    managerFilePatterns: [
      '/go\\.mod$/',
    ],
  },
  semanticCommitType: 'chore',
  packageRules: [
    {
      // Patch + minor go dependencies land grouped to keep go.sum churn low.
      matchDatasources: [
        'go',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'go dependencies',
      groupSlug: 'go-deps',
      automerge: true,
      automergeType: 'pr',
    },
    {
      // Major go dependencies require explicit human review.
      matchDatasources: [
        'go',
      ],
      matchUpdateTypes: [
        'major',
      ],
      groupName: 'go dependencies (major)',
      groupSlug: 'go-deps-major',
      automerge: false,
      dependencyDashboardApproval: true,
      labels: [
        'major-update',
      ],
      semanticCommitType: 'fix',
    },
  ],
}
