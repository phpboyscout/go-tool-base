
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# VS Code
.vscode

# IntelliJ
.idea


# Temporary files
tmp/

/coverage*
bin/*
site/*
# Generated man-page tree (output of `just man` / `gtb generate man`)
/man/
/gtb
/e2e
/mcp-tools.json
internal/cmd/root/assets/docs
tmp*
 .env*
 site*
 .cache*
dist*
.claude*
CHANGELOG.md

# Locally-saved CI logs
*.log

# Apple signing secrets — must NEVER be committed.
# The .p8 is the App Store Connect API private key; the .cer is
# the public half of the Developer ID Application certificate; the
# .p12 is the combined identity used by `productsign`/`codesign`.
*.p8
*.cer
*.p12
*.pem

# Cloudflare wrangler local cache
.wrangler/
!cmd/e2e/assets/CHANGELOG.md
